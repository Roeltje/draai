HOST=127.0.0.1
PORT=3210
DATA_DIR=./data
# Vul lokaal je eigen Discogs-gebruikersnaam in.
DISCOGS_USERNAME=
DISCOGS_TOKEN=
# Vul lokaal je eigen Weather Underground-station-ID in.
WU_STATION_ID=
WU_API_KEY=
# Opt-in: sends Discogs album/artist IDs to Wikidata, fetches Wikipedia articles.
# Listening history and personal notes are not sent.
WIKI_ENABLED=false
# Aanbevolen door Wikimedia: contact (URL of e-mail) in de User-Agent.
WIKI_CONTACT=
# Production LAN example: http://192.168.1.50:3210
APP_ORIGIN=
# Alleen Docker: zet een image-versie vast (bijv. 0.2.0); leeg = latest.
DRAAI_VERSION=
