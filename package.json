{
  "name": "draai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "backup": "node scripts/backup.mjs",
    "format": "prettier --write \"{src,server,shared,tests,scripts}/**/*.{ts,tsx,css,mjs}\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "packageManager": "pnpm@11.25.0"
}
