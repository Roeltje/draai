{
  "_info": {
    "doel": "Basis-mapping voor draai: weer -> stemming, Discogs genre/style -> stemming, seizoensmomenten.",
    "gewichten": "0.0 - 1.0. Zachte gewichten, geen harde filters. Score plaat = som(weerconditie.gewicht * plaat.stemming.gewicht) + gekozen stemming + randomfactor - 'recent gedraaid'-straf.",
    "fallback": "Style heeft voorrang op genre. Heeft een plaat geen gemapte style, dan valt hij terug op het genre.",
    "let_op": "Style-namen zijn gespeld zoals Discogs ze gebruikt. Check je eigen collectie: tel alle styles en map in elk geval de top 30-50."
  },
  "stemmingen": {
    "rustig": {
      "nieuw": false,
      "omschrijving": "Laag tempo, weinig prikkels"
    },
    "warm": {
      "nieuw": false,
      "omschrijving": "Knus, soulvol, akoestisch. Overweeg te hernoemen naar 'knus' zodat het niet botst met warm weer"
    },
    "energiek": {
      "nieuw": false,
      "omschrijving": "Tempo, drive, opstaan en bewegen"
    },
    "avontuurlijk": {
      "nieuw": false,
      "omschrijving": "Iets wat je zelden draait, experimenteel, onbekend terrein"
    },
    "nostalgisch": {
      "nieuw": false,
      "omschrijving": "Oude liefdes, jeugd, klassiekers"
    },
    "melancholisch": {
      "nieuw": true,
      "omschrijving": "Weemoedig, mooi-droevig. Grijze zondag, motregen"
    },
    "feestelijk": {
      "nieuw": true,
      "omschrijving": "Mensen over de vloer, meezingen, dansen"
    },
    "focus": {
      "nieuw": true,
      "omschrijving": "Achtergrond bij werken/lezen, weinig vocalen"
    },
    "dromerig": {
      "nieuw": true,
      "omschrijving": "Zweverig, sfeervol, laat op de avond, mist"
    }
  },
  "drempels": {
    "_uitleg": "Instelbaar via sliders. Vergelijk bij voorkeur gevoelstemperatuur (windchill / heatIndex uit de PWS-data), niet de kale temperatuur.",
    "koud_c": 5,
    "warm_c": 22,
    "heet_c": 28,
    "relatief_t_o_v_maandnormaal": {
      "aan": true,
      "koud_afwijking_c": -5,
      "warm_afwijking_c": 5,
      "_uitleg": "15 graden voelt in maart warm en in juli koud. Conditie 'koud'/'warm' geldt als absolute OF relatieve drempel geraakt wordt."
    },
    "hysterese_c": 1.5,
    "harde_wind_kmh": 39,
    "storm_windstoot_kmh": 60,
    "regen_mm_per_uur": {
      "motregen_tot": 1.0,
      "regen_tot": 4.0
    },
    "mist_dauwpunt_verschil_c": 1.5,
    "drukdaling_hpa_per_3u": 3
  },
  "weercondities": {
    "zonnig": {
      "detectie": "overdag, solarRadiation > 60% van verwachte heldere-hemelstraling, precipRate = 0",
      "stemmingen": {
        "energiek": 0.8,
        "feestelijk": 0.5,
        "avontuurlijk": 0.5,
        "warm": 0.3
      }
    },
    "grijs": {
      "detectie": "overdag, solarRadiation < 30% van verwachte heldere-hemelstraling, geen neerslag",
      "stemmingen": {
        "rustig": 0.6,
        "melancholisch": 0.5,
        "warm": 0.5,
        "focus": 0.4,
        "nostalgisch": 0.4
      }
    },
    "motregen": {
      "detectie": "0 < precipRate < 1 mm/u",
      "stemmingen": {
        "melancholisch": 0.7,
        "rustig": 0.6,
        "dromerig": 0.5,
        "nostalgisch": 0.4
      }
    },
    "regen": {
      "detectie": "1 - 4 mm/u",
      "stemmingen": {
        "warm": 0.7,
        "rustig": 0.6,
        "melancholisch": 0.6,
        "nostalgisch": 0.5,
        "focus": 0.4
      }
    },
    "plensbui": {
      "detectie": "> 4 mm/u",
      "stemmingen": {
        "avontuurlijk": 0.6,
        "energiek": 0.4,
        "melancholisch": 0.4
      }
    },
    "harde_wind": {
      "detectie": "windSpeed > harde_wind_kmh of windGust > storm_windstoot_kmh",
      "stemmingen": {
        "avontuurlijk": 0.7,
        "energiek": 0.5
      }
    },
    "mist": {
      "detectie": "temp - dewpt < mist_dauwpunt_verschil_c, wind < 5 km/u, humidity > 95%",
      "stemmingen": {
        "dromerig": 0.9,
        "rustig": 0.6,
        "melancholisch": 0.4
      }
    },
    "vorst": {
      "detectie": "temp < 0",
      "stemmingen": {
        "warm": 0.6,
        "rustig": 0.5,
        "nostalgisch": 0.5
      }
    },
    "sneeuw": {
      "detectie": "temp <= 1 en precipRate > 0 (benadering, PWS meet geen sneeuw)",
      "stemmingen": {
        "rustig": 0.8,
        "dromerig": 0.6,
        "nostalgisch": 0.5
      }
    },
    "koud": {
      "detectie": "gevoelstemperatuur < koud_c (of relatief)",
      "stemmingen": {
        "warm": 0.8,
        "nostalgisch": 0.5,
        "rustig": 0.4
      }
    },
    "warm": {
      "detectie": "gevoelstemperatuur > warm_c (of relatief)",
      "stemmingen": {
        "energiek": 0.6,
        "feestelijk": 0.6,
        "avontuurlijk": 0.5
      }
    },
    "heet": {
      "detectie": "heatIndex > heet_c of dauwpunt > 18 (benauwd)",
      "stemmingen": {
        "rustig": 0.6,
        "dromerig": 0.6,
        "warm": 0.3
      }
    },
    "donker": {
      "detectie": "zon onder de horizon (berekend uit lat/lon van je station)",
      "stemmingen": {
        "rustig": 0.5,
        "dromerig": 0.5,
        "warm": 0.4,
        "melancholisch": 0.3
      }
    },
    "weer_slaat_om": {
      "detectie": "luchtdruk daalt > drukdaling_hpa_per_3u",
      "stemmingen": {
        "avontuurlijk": 0.4,
        "melancholisch": 0.3
      }
    }
  },
