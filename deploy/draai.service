[Unit]
Description=Draai - persoonlijke platenkiezer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=draai
Group=draai
WorkingDirectory=/opt/draai
EnvironmentFile=/etc/draai.env
Environment=NODE_ENV=production
ExecStart=/opt/draai-node/bin/node --import tsx server/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
StateDirectory=draai
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/draai

[Install]
WantedBy=multi-user.target
